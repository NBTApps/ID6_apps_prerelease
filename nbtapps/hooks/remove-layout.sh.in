# SPDX-License-Identifier: MIT
# preRemove hook of the @FOLDER@ package (NBTApps), made by nbtapps/make_nbtpkg.py from remove-layout.sh.in.
#
# Removes what no package's record has, which the agent would therefore leave on the head unit:
#   - the files the plugin itself writes while it runs, outside its folder (nbtapps/apps.json, "written"), and
#     the temporary files it makes beside them, <file>.XXXXXX. For this app: @WRITTEN@
#   - the two files select-layout.sh made, @FOLDER@.xml and @FOLDER@_ALL_Images.zip in the plugin folder, and
#     whatever select-layout.sh may have left behind if it was stopped.
# The agent then removes the package's own files, and the plugin folder once it is empty. Nothing else in the folder
# is touched: an owner may keep a gateway-ip.txt there. The agent runs this hook when the package is removed and
# not when it is upgraded, so what the app saved stays across an upgrade; should it ever run for an upgrade
# (NBT_ACTION=upgrade), the written files are left alone.
#
# Exit status: 0, also when the files or NBT_VAR_PLUGINS_DIR are not there; 1 when a file could not be removed
# (the agent logs that and removes the package anyway).

folder=@FOLDER@
written="@WRITTEN@"

left=
gone=
if [ "$NBT_ACTION" != upgrade ]; then
    for f in $written; do
        for g in "$f" "$f".??????; do
            if [ -f "$g" ]; then
                rm -f "$g"
                if [ -f "$g" ]; then
                    left="$left $g"
                else
                    gone="$gone $g"
                fi
            fi
        done
    done
fi
if [ -n "$gone" ]; then
    echo "$folder: removed what the app saved:$gone"
fi

layout=
if [ -z "$NBT_VAR_PLUGINS_DIR" ]; then
    echo "$folder: NBT_VAR_PLUGINS_DIR is not set, so the plugin folder cannot be found; no layout removed"
else
    dir=$NBT_VAR_PLUGINS_DIR/$folder
    xml=$dir/$folder.xml
    zip=$dir/${folder}_ALL_Images.zip
    rm -f "$xml" "$zip" "$dir/.select-layout.screen" "$dir/.select-layout.xml" "$dir/.select-layout.zip" \
        "$dir/.select-layout.xml.old"
    for f in "$xml" "$zip" "$dir/.select-layout.screen" "$dir/.select-layout.xml" "$dir/.select-layout.zip" \
        "$dir/.select-layout.xml.old"; do
        if [ -f "$f" ]; then
            left="$left $f"
        fi
    done
    layout=yes
fi
if [ -n "$left" ]; then
    echo "$folder: could not remove$left" >&2
    exit 1
fi
if [ -n "$layout" ]; then
    echo "$folder: the active layout is removed"
fi
exit 0
